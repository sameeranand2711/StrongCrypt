<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StrongCrypt.ConsoleDemo — Minimal demonstration of encryption/decryption round-trip.

    WARNING: This demo combines both encryption and decryption capabilities for
    demonstration purposes only. Production services should reference only ONE
    package (StrongCrypt.Encryption OR StrongCrypt.Decryption), never both.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StrongCrypt.Encryption\StrongCrypt.Encryption.csproj" />
    <ProjectReference Include="..\..\src\StrongCrypt.Decryption\StrongCrypt.Decryption.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
