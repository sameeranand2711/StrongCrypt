<Project>

  <!--
    Repository-wide build settings for StrongCrypt V1.

    Applies to every project under the repository root. Project-specific
    overrides live in src/Directory.Build.props and tests/Directory.Build.props,
    both of which import this file explicitly.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>

    <!-- Explicit usings only: crypto code should show its dependencies. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Fail the build on any warning; security code must stay warning-clean. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Reproducible, auditable output. -->
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- V1 never needs unsafe blocks. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- No implicit NuGet feed mutation during restore. -->
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>

    <!-- Package metadata -->
    <Version>1.0.0-rc.1</Version>
    <Authors>StrongCrypt Contributors</Authors>
    <Copyright>Copyright © 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sameeranand2711/StrongCrypt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sameeranand2711/StrongCrypt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>encryption;aes;gcm;cryptography;security</PackageTags>
  </PropertyGroup>

</Project>
